extends SceneTree

func _initialize() -> void:
    call_deferred("run_check")

func run_check() -> void:
    var scene: Node = load("res://ReconstructedMain.tscn").instantiate()
    root.add_child(scene)
    await process_frame
    assert(scene.facility.summary().rack_count == 8)
    assert(scene.facility.summary().power_on)
    assert(scene.facility.summary().cooling_units == 2)
    assert(scene.facility.summary().cooling_enabled)
    assert(scene.diagnostics.assess(scene.facility.summary()).severity == "NORMAL")
    scene._toggle_demo_filter()
    assert(scene.diagnostics.assess(scene.facility.summary()).severity == "ATTENTION")
    scene._toggle_demo_sensor()
    assert(not scene.diagnostics.assess(scene.facility.summary()).temperature_valid)
    scene._process(0.0)
    assert("UNKNOWN" in scene.engineering_status.text)
    assert("SENSOR UNKNOWN" in scene.diagnostic_status.text)
    scene._toggle_demo_filter()
    scene._toggle_demo_sensor()
    scene._toggle_cooling()
    assert(not scene.facility.summary().cooling_enabled)
    var before_heat: float = scene.facility.air_temperature
    scene.facility._process(1.0)
    assert(scene.facility.air_temperature > before_heat)
    scene._toggle_cooling()
    assert(scene.facility.summary().cooling_enabled)
    var before_cool: float = scene.facility.air_temperature
    scene.facility._process(1.0)
    assert(scene.facility.air_temperature < before_cool)
    scene._toggle_rack_power()
    assert(not scene.facility.summary().power_on)
    scene._toggle_rack_power()
    assert(scene.facility.summary().power_on)
    var cell = scene.cell
    var first: Dictionary = cell.summary()
    assert(first.missing_animated_nodes == 0)
    assert(first.lod == 0)
    scene._cell_stop()
    assert(scene.diagnostics.assess(scene.facility.summary()).severity == "STOPPED")
    assert(cell.summary().estop_latched)
    assert(scene.facility.summary().emergency_latched)
    assert(not scene.facility.summary().cooling_enabled)
    assert(not scene.facility.summary().power_on)
    scene.facility.set_power(true)
    assert(not scene.facility.summary().power_on)
    scene._cell_resume()
    assert(not cell.summary().estop_latched)
    assert(not scene.facility.summary().emergency_latched)
    assert(not scene.facility.summary().power_on)
    assert(not scene.facility.summary().cooling_enabled)
    assert(cell.summary().motion_enabled)
    scene._toggle_quality()
    assert(cell.summary().lod == 1)
    assert(cell.summary().missing_animated_nodes == 0)
    scene._cell_view()
    assert(scene.focus == Vector3(0, 2.0, 9.2))
    print("RECONSTRUCTION_SMOKE_PASS")
    quit(0)
