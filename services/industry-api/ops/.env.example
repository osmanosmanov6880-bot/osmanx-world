# Copy to .env locally and chmod 600. NEVER commit a real .env.
# Generate 32-byte hexadecimal credentials: openssl rand -hex 32
POSTGRES_ADMIN_PASSWORD=REPLACE_WITH_64_HEX_CHARS
INDUSTRY_APP_PASSWORD=REPLACE_WITH_64_HEX_CHARS
INDUSTRY_WORKER_PASSWORD=REPLACE_WITH_64_HEX_CHARS
WEBHOOK_HMAC_KEY=REPLACE_WITH_64_HEX_CHARS
WEBHOOK_URL=https://your-trusted-receiver.example/events
BOOTSTRAP_EMAIL=owner@example.com
BOOTSTRAP_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
BOOTSTRAP_TENANT_SLUG=first-clinic
BOOTSTRAP_TENANT_NAME=First Clinic
BOOTSTRAP_VERTICAL=dental
AGE_RECIPIENT_1=
AGE_RECIPIENT_2=
DR_RESTORE_DB_URL=

# R6 fail-closed: do not enable until separate admin, DR and 2-person staging acceptance.
GUEST_WRITES_ENABLED=false
# Provide independent age recipients from OFF-SERVER keys before real backups:
# AGE_RECIPIENT_1=age1...
# AGE_RECIPIENT_2=age1...

# CINEMA R3 - all disabled until legal/technical acceptance
# CINEMA_TENANT_ID=<UUID of the operator tenant>
# CINEMA_RATE_SECRET=<random 32+ character secret, never commit>
CINEMA_PUBLIC_WRITE_ENABLED=false
CINEMA_AGGREGATE_EVENTS_ENABLED=false

# CINEMA R5: documentation flags, NEVER set true as a substitute for review
CINEMA_R5_OPERATOR_REVIEWED=false
# Verify CINEMA_LEGAL_CONTROLLER_APPROVED, CINEMA_MAILBOX_VERIFIED,
# CINEMA_RETENTION_TIMER_VERIFIED and CINEMA_RESTORE_VERIFIED separately.

# CINEMA R6, disabled until independently reviewed staging evidence
CINEMA_R6_OPERATOR_REVIEWED=false
